%CCOMPILER      g++-16 -I/opt/homebrew/opt/open-mpi/include
%FCOMPILER      mpif90
%LINKER         mpif90

%BASE_CFLAGS    -w -std=c++11
%PROD_CFLAGS    -O2 -D BOOST_DISABLE_ASSERTS
%DEV_CFLAGS     -g
%DEBUG_CFLAGS   -g -O0

%BASE_FFLAGS    -D__NONE__ -ffree-line-length-none
%PROD_FFLAGS    -O2
%DEV_FFLAGS     -g -O2
%DEBUG_FFLAGS   -g

%BASE_INC       -D__NONE__
%BASE_LD        -lstdc++

%CPP            /opt/homebrew/bin/cpp-16
%FPP            /opt/homebrew/bin/cpp-16 -P
%MAKE           make
