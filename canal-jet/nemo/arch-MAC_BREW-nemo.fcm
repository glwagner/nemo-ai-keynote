# macOS (Apple Silicon) + Homebrew gcc/open-mpi/netcdf
%XIOS_HOME           $HOME/nemo/xios2
%NCDF_INC            -I/opt/homebrew/include
%NCDF_LIB            -L/opt/homebrew/lib -lnetcdff -lnetcdf
%XIOS_INC            -I%XIOS_HOME/inc
%XIOS_LIB            -L%XIOS_HOME/lib -lxios -lstdc++
%CPP                 /opt/homebrew/bin/cpp-16 -Dkey_nosignedzero
%FC                  mpif90 -c -cpp
%FCFLAGS             -fdefault-real-8 -O3 -funroll-all-loops -fcray-pointer -ffree-line-length-none -Wno-missing-include-dirs -fallow-argument-mismatch
%FFLAGS              %FCFLAGS
%LD                  mpif90
%LDFLAGS             
%FPPFLAGS            -P -traditional
%AR                  ar
%ARFLAGS             rs
%MK                  make
%USER_INC            %XIOS_INC %NCDF_INC
%USER_LIB            %XIOS_LIB %NCDF_LIB
%CC                  cc
%CFLAGS              -O0
